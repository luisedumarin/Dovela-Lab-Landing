---
import CourseCard from "./CourseCard.astro";
const courses = [
  {
    title: "Láminas Arquitectónicas Profesionales",
    img: "/FOTOSCURSO/TALLERLAMINAS.PNG",
    badge: "Presencial",
    price: "$699 MXN",
    desc: "Transforma tus proyectos en presentaciones que venden. En 12 horas intensivas dominarás la presentación profesional.",
  },
  {
    title: "Introducción a la Metodología BIM",
    img: "/FOTOSCURSO/METODOLOGIABIM.PNG",
    badge: "En línea",
    price: "$699 MXN",
    desc: "Entiende qué es BIM, cómo se implementa y por qué las empresas lo exigen.",
  },
  {
    title: "Proyecto Ejecutivo Básico",
    img: "/FOTOSCURSO/PROYECTOEJECUTIVOBASICO.PNG",
    badge: "Presencial",
    price: "$699 MXN",
    desc: "Aprende a estructurar proyectos ejecutivos completos: plantas, cortes y coordinación.",
  },
  {
    title: "Proyecto MEP Básico en Revit",
    img: "/FOTOSCURSO/PROYECTOMEP.PNG",
    badge: "En línea",
    price: "$699 MXN",
    desc: "Modela instalaciones hidráulicas, sanitarias, eléctricas y de climatización en Revit.",
  },
];
---

<section id="cursos">
  <div class="max-w-6xl mx-auto px-5 pt-12 pb-20 md:pt-16">
    <div class="reveal text-center mb-16">
      <h2
        class="text-3xl md:text-6xl font-extrabold text-black-900 leading-tight"
      >
        Cursos Disponibles
      </h2>
      <p class="mt-3 text-gray-600 max-w-xl mx-auto">
        “Conoce nuestros cursos y prepárate para las oportunidades del futuro.”
      </p>
    </div>

    <div
      class="cg grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-8 justify-items-center justify-center"
    >
      {
        courses.map((c) => (
          <CourseCard
            title={c.title}
            img={c.img}
            badge={c.badge}
            price={c.price}
            desc={c.desc}
          />
        ))
      }
    </div>
  </div>
</section>
