---

---

<nav
  id="nav"
  class="fixed top-0 left-0 right-0 z-[9999] px-[5%] bg-gradient-to-br from-[#c7663c] to-[#8e4b31] bg-opacity-100 shadow-[0_10px_30px_rgba(42,24,19,.12)]"
  role="navigation"
  aria-label="Main navigation"
>
  <div
    class="ni max-w-[1280px] mx-auto flex items-center justify-between h-[76px]"
  >
    <a
      href="#"
      class="logo flex items-center gap-3 text-white no-underline"
      aria-label="Ir al inicio"
      data-reset-home
    >
      <div class="logo-ico w-[150px] h-[150px] flex-shrink-0">
        <img
          src="/images/logo/LOGODOVELA.png"
          alt="Dovela Lab logo"
          width="64"
          height="64"
          class="w-full h-full object-contain filter grayscale brightness-0 invert"
        />
      </div>
    </a>

    <ul class="nl hidden gap-10 list-none md:flex">
      <li>
        <a
          href="#cursos"
          class="group relative inline-flex pb-1 text-[1rem] font-semibold tracking-[.7px] text-white/90 no-underline after:absolute after:left-0 after:-bottom-[2px] after:h-[2px] after:w-0 after:rounded-full after:bg-white after:transition-all after:duration-300 hover:after:w-full"
          >Cursos</a
        >
      </li>
      <li>
        <a
          href="#fechas"
          class="group relative inline-flex pb-1 text-[1rem] font-semibold tracking-[.7px] text-white/90 no-underline after:absolute after:left-0 after:-bottom-[2px] after:h-[2px] after:w-0 after:rounded-full after:bg-white after:transition-all after:duration-300 hover:after:w-full"
          >Fechas</a
        >
      </li>
      <li>
        <a
          href="#faq"
          class="group relative inline-flex pb-1 text-[1rem] font-semibold tracking-[.7px] text-white/90 no-underline after:absolute after:left-0 after:-bottom-[2px] after:h-[2px] after:w-0 after:rounded-full after:bg-white after:transition-all after:duration-300 hover:after:w-full"
          >Preguntas</a
        >
      </li>
    </ul>

    <a
      href="#cta"
      class="ncta hidden md:inline-flex items-center justify-center rounded-full bg-[#fcd34d] px-[1.9rem] py-[.72rem] text-[1.25rem] font-bold tracking-[.8px] text-black no-underline shadow-[0_6px_18px_rgba(42,24,19,.18)] transition-all duration-200 hover:-translate-y-[1px] hover:bg-[#f8c94e] hover:shadow-[0_10px_24px_rgba(42,24,19,.24)]"
      >Inscribirme</a
    >

    <button
      class="hamburger md:hidden flex flex-col gap-[5px] bg-transparent p-[6px] border-0 cursor-pointer relative z-[10001] pointer-events-auto"
      id="hamburger"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="block w-6 h-[2px] bg-white rounded-[2px]"></span>
      <span class="block w-6 h-[2px] bg-white rounded-[2px]"></span>
      <span class="block w-6 h-[2px] bg-white rounded-[2px]"></span>
    </button>
  </div>
</nav>

<div
  id="mobile-nav"
  class="mobile-nav fixed top-[76px] left-0 right-0 bottom-0 hidden flex-col items-center justify-center gap-10 bg-white/98 backdrop-blur-[20px] opacity-0 pointer-events-none translate-y-[-12px] transition-all duration-300 z-[700]"
  aria-hidden="true"
>
  <a
    href="#cursos"
    class="text-[1.4rem] font-extrabold text-[#2a1813] tracking-[1px] no-underline"
    >Cursos</a
  >
  <a
    href="#fechas"
    class="text-[1.4rem] font-extrabold text-[#2a1813] tracking-[1px] no-underline"
    >Fecha</a
  >
  <a
    href="#faq"
    class="text-[1.4rem] font-extrabold text-[#2a1813] tracking-[1px] no-underline"
    >Preguntas</a
  >
  <a
    href="#cta"
    class="ncta mt-2 rounded-full bg-[#fcd34d] px-10 py-3 text-[.95rem] font-bold text-black no-underline shadow-[0_6px_18px_rgba(42,24,19,.18)] transition-all duration-200 hover:-translate-y-[1px] hover:bg-[#f8c94e] hover:shadow-[0_10px_24px_rgba(42,24,19,.24)]"
    >Inscribirme</a
  >
</div>

<script>
  (function () {
    // Inline fallback toggle for mobile hamburger -- small, defensive and safe.
    try {
      const h = document.getElementById("hamburger");
      const m = document.getElementById("mobile-nav");
      if (!h || !m) return;
      if (h.dataset._inlineAdded) return;
      h.dataset._inlineAdded = "1";
      h.addEventListener(
        "click",
        function (e) {
          // prevent other click listeners on this element from running (defensive)
          try {
            e.stopImmediatePropagation();
          } catch (err) {}
          const open = h.classList.toggle("open");
          if (open) {
            m.style.display = "flex";
            m.setAttribute("aria-hidden", "false");
            h.setAttribute("aria-expanded", "true");
            requestAnimationFrame(() => m.classList.add("open"));
            document.body.classList.add("mobile-menu-open");
            document.body.style.overflow = "hidden";
          } else {
            m.classList.remove("open");
            m.setAttribute("aria-hidden", "true");
            h.setAttribute("aria-expanded", "false");
            setTimeout(() => (m.style.display = "none"), 280);
            document.body.classList.remove("mobile-menu-open");
            document.body.style.overflow = "";
          }
        },
        true,
      );
    } catch (e) {
      /* no-op */
    }
  })();
</script>

<style>
  /* estado abierto del menú móvil */
  .mobile-nav.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    background: linear-gradient(
      160deg,
      rgba(24, 14, 11, 0.97),
      rgba(50, 28, 20, 0.96)
    );
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .mobile-nav.open a:not(.ncta) {
    color: #f8f1ea;
  }

  /* Mobile: mostrar items en una sola línea proporcional */
  @media (max-width: 767px) {
    .mobile-nav.open {
      position: fixed;
      top: 76px;
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
      padding: 1.25rem 1rem;
      overflow-y: auto;
      white-space: normal;
      transform: none;
      z-index: 900;
    }

    .mobile-nav.open a {
      color: #f8f1ea;
      font-size: 1.25rem;
      font-weight: 800;
      padding: 0.25rem 0.5rem;
      display: block;
      text-align: center;
    }

    .mobile-nav.open a.ncta {
      background: #fcd34d;
      color: #000;
      padding: 0.6rem 1rem;
      border-radius: 8px;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
    }
  }
</style>
